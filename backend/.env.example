# Copy this file to ".env" (same folder) and edit it. NEVER commit ".env" to GitHub:
# it holds secrets. (.gitignore already blocks it.)

# A long random string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# 1 = development (shows detailed errors). MUST be 0 in production.
DJANGO_DEBUG=1

# Domains that may serve this app, comma separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Front-end addresses allowed to call the API from a browser (CORS).
# Origin = scheme + host (+ port), with NO path and NO trailing slash.
# GitHub Pages example:  https://123anjan.github.io
CORS_ALLOWED_ORIGINS=http://localhost:8765,http://127.0.0.1:8765,https://123anjan.github.io

# Needed for the /admin/ login over HTTPS on your real domain.
CSRF_TRUSTED_ORIGINS=

# Database. Leave on sqlite for development.
DB_ENGINE=sqlite
# For MySQL on Hostinger set: DB_ENGINE=mysql and fill these in
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
